<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDC9A6"
    android:padding="28dp"
    tools:context=".AuthActivity">

    <!-- Container Utama di Tengah Layar -->
    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="#FFE5D2"
        android:padding="28dp"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/killer_log"
            android:layout_marginBottom="16dp" />

        <!-- Judul Halaman -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selamat Datang"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FF8908" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Silakan masuk untuk melanjutkan"
            android:textSize="13sp"
            android:textColor="#9E690E"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Input Username -->
        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Username"
            android:textColorHint="#D9C19B"
            android:textColor="#E7CEB0"
            android:textSize="14sp"
            android:inputType="textPersonName"
            android:background="#F1F5F9"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="14dp" />

        <!-- Input Password -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Password"
            android:textColorHint="#DCAF8C"
            android:textColor="#1E293B"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:background="#F1F5F9"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="24dp" />

        <!-- Tombol Login -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Login"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#ED9819" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>